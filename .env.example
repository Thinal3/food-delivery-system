# Copy this file to .env and replace every password/secret with a unique value.
# Generate each value as hexadecimal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MARIADB_ROOT_PASSWORD=replace_with_64_hex_characters
AUTH_DB_PASSWORD=replace_with_64_hex_characters
RESTAURANT_DB_PASSWORD=replace_with_64_hex_characters
ORDER_DB_PASSWORD=replace_with_64_hex_characters
DELIVERY_DB_PASSWORD=replace_with_64_hex_characters
CUSTOMER_DB_PASSWORD=replace_with_64_hex_characters
JWT_SECRET=replace_with_at_least_32_random_characters
ORDER_DELIVERY_SYNC_SECRET=replace_with_at_least_32_random_characters

# Existing application defaults; change only when your assignment requires it.
JWT_EXPIRES_IN=15m
JWT_ISSUER=food-delivery-auth
JWT_AUDIENCE=food-delivery-services
DELIVERY_FEE=250.00
AUTH_REQUEST_TIMEOUT_MS=5000
SERVICE_REQUEST_TIMEOUT_MS=5000
SYNC_POLL_INTERVAL_MS=1000
SYNC_MAX_ATTEMPTS=8
DB_CONNECTION_LIMIT=10
DB_STARTUP_MAX_ATTEMPTS=30
